[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/Cultivating-Solutions/battlebetz-app.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[lfs]
	repositoryformatversion = 0
[branch "dev"]
	remote = origin
	merge = refs/heads/dev
[branch "matrix_updates"]
	vscode-merge-base = origin/dev
	remote = origin
	merge = refs/heads/matrix_updates
